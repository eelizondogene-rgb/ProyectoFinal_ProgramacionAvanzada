@model SistemaEventos.Application.DTOs.EventoDto

<div class="modal fade" id="modalEditarEvento" tabindex="-1" aria-labelledby="modalEditarEventoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered vehicle-modal-dialog">
        <div class="modal-content vehicle-modal">
            <form id="formEditarEvento" asp-controller="Evento" asp-action="ActualizarEvento" method="post">
                <div class="modal-header vehicle-modal-header">
                    <div class="vehicle-modal-heading">
                        <span class="vehicle-modal-icon"><i class="bi bi-pencil-square"></i></span>
                        <div>
                            <span class="vehicle-modal-eyebrow">ACTUALIZAR REGISTRO</span>
                            <h5 class="modal-title" id="modalEditarEventoLabel">Editar evento</h5>
                            <p class="vehicle-modal-subtitle">Revisa y actualiza la información del evento. La fecha debe ser futura.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body vehicle-modal-body">
                    <input asp-for="Id" type="hidden" />
                    <div class="vehicle-field mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <div class="vehicle-control">
                            <i class="bi bi-card-text" aria-hidden="true"></i>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Concierto de rock" maxlength="100" autocomplete="off" required />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <div class="vehicle-control">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            <input asp-for="Descripcion" class="form-control" placeholder="Ej. Presentación en vivo" autocomplete="off" required />
                        </div>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="Lugar" class="form-label">Lugar</label>
                        <div class="vehicle-control">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            <input asp-for="Lugar" class="form-control" placeholder="Ej. Estadio Nacional" autocomplete="off" required />
                        </div>
                        <span asp-validation-for="Lugar" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="Capacidad" class="form-label">Capacidad (1 a 100)</label>
                        <div class="vehicle-control">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <input asp-for="Capacidad" type="number" min="1" max="100" step="1" class="form-control" placeholder="Ej. 100" required />
                        </div>
                        <span asp-validation-for="Capacidad" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="PrecioEntrada" class="form-label">Precio de la entrada (₡)</label>
                        <div class="vehicle-control">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <input asp-for="PrecioEntrada" type="number" min="0" step="1" class="form-control" placeholder="Ej. 15000" required />
                        </div>
                        <span asp-validation-for="PrecioEntrada" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer vehicle-modal-footer">
                    <button type="button" class="btn btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-modal-primary" id="btnEditarEvento"><i class="bi bi-check2"></i> Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
