@model SistemaEventos.Application.DTOs.MapaAsientosDto

@{
    ViewData["Title"] = "Selección de asientos";

    var columnas = Model.Asientos
        .Select(a => a.Columna)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    var filas = Model.Asientos
        .GroupBy(a => a.Fila)
        .OrderBy(g => g.Key)
        .ToList();
}

<style>
    .seleccion-mapa {
        overflow-x: auto;
    }

    .seleccion-grilla {
        display: grid;
        gap: 0.35rem;
        min-width: 40rem;
        align-items: stretch;
    }

    .seleccion-eje {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 2.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
    }

    .seleccion-celda .btn {
        width: 100%;
        min-height: 2.5rem;
        padding: 0.25rem;
        font-size: 0.8rem;
    }

    .seleccion-leyenda {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
    }

    .seleccion-muestra {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.75rem;
        min-height: 2rem;
        margin-right: 0.4rem;
        border-radius: 0.375rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .seleccion-muestra-disponible {
        color: var(--bs-primary);
        background: transparent;
        border: 1px solid var(--bs-primary);
    }

    .seleccion-muestra-seleccionado {
        color: #fff;
        background: var(--bs-primary);
        border: 1px solid var(--bs-primary);
    }

    .seleccion-muestra-ocupado,
    .seleccion-ocupado .seleccion-asiento-ocupado {
        color: #fff;
        background: #6c757d;
        border: 1px solid #6c757d;
        cursor: not-allowed;
    }

    .seleccion-ocupado .seleccion-asiento-ocupado {
        pointer-events: none;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="fw-bold mb-2">@Model.Nombre</h2>
                    <p class="text-muted mb-4">
                        Selecciona los asientos y continúa al resumen.
                    </p>

                    <div class="row mb-4">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <span class="text-muted">Capacidad</span>
                            <div class="fw-semibold">@Model.Capacidad</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Precio por entrada</span>
                            <div class="fw-semibold">@Model.PrecioEntrada</div>
                        </div>
                    </div>

                    <form id="formSeleccionMapa"
                          asp-controller="Seleccion"
                          asp-action="Resumen"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EventoId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        @if (filas.Count == 0)
                        {
                            <div class="alert alert-info" role="status">
                                No hay asientos para mostrar.
                            </div>
                        }
                        else
                        {
                            <fieldset>
                                <legend class="fs-6 fw-semibold mb-3">
                                    Mapa de asientos
                                </legend>

                                <ul class="seleccion-leyenda list-unstyled mb-3"
                                    aria-label="Leyenda del mapa">
                                    <li>
                                        <span class="seleccion-muestra seleccion-muestra-disponible"
                                              aria-hidden="true">A1</span>
                                        Disponible
                                    </li>
                                    <li>
                                        <span class="seleccion-muestra seleccion-muestra-seleccionado"
                                              aria-hidden="true">A1</span>
                                        Seleccionado
                                    </li>
                                    <li>
                                        <span class="seleccion-muestra seleccion-muestra-ocupado"
                                              aria-hidden="true">A1</span>
                                        Ocupado
                                    </li>
                                </ul>

                                <div class="seleccion-mapa">
                                    <div class="seleccion-grilla"
                                         style="grid-template-columns: auto repeat(@columnas.Count, minmax(2.75rem, 1fr));">

                                        <span class="seleccion-eje" aria-hidden="true"></span>

                                        @foreach (var columna in columnas)
                                        {
                                            <span class="seleccion-eje"
                                                  id="columna-@columna">
                                                @columna
                                            </span>
                                        }

                                        @foreach (var fila in filas)
                                        {
                                            var ordenados = fila.OrderBy(a => a.Columna).ToList();
                                            var primero = ordenados[0];
                                            var letra = !string.IsNullOrEmpty(primero.Etiqueta)
                                                && char.IsLetter(primero.Etiqueta[0])
                                                ? char.ToUpperInvariant(primero.Etiqueta[0]).ToString()
                                                : primero.Fila.ToString();

                                            <span class="seleccion-eje"
                                                  id="fila-@primero.Fila">
                                                @letra
                                            </span>

                                            @foreach (var asiento in ordenados)
                                            {
                                                var identificador = $"asiento-{asiento.Fila}-{asiento.Columna}";
                                                var seleccionado = asiento.Seleccionado && !asiento.Ocupado;

                                                <div class="seleccion-celda @(asiento.Ocupado ? "seleccion-ocupado" : null)">
                                                    @if (asiento.Ocupado)
                                                    {
                                                        <span class="btn seleccion-asiento-ocupado"
                                                              aria-disabled="true"
                                                              aria-label="Asiento @asiento.Etiqueta ocupado"
                                                              title="Ocupado">
                                                            @asiento.Etiqueta
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox"
                                                               class="btn-check"
                                                               name="Posiciones"
                                                               id="@identificador"
                                                               value="@($"{asiento.Fila}-{asiento.Columna}")"
                                                               autocomplete="off"
                                                               aria-label="Asiento @asiento.Etiqueta"
                                                               aria-describedby="fila-@asiento.Fila columna-@asiento.Columna"
                                                               @(seleccionado ? "checked" : null) />
                                                        <label class="btn btn-outline-primary"
                                                               for="@identificador">
                                                            @asiento.Etiqueta
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </fieldset>
                        }

                        <button type="submit"
                                class="btn btn-primary w-100 py-2 mt-4">
                            Continuar al resumen
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var formulario = document.getElementById('formSeleccionMapa');

        if (!formulario) {
            return;
        }

        var retirarOcupado = function (origen) {
            var celda = origen && origen.closest
                ? origen.closest('.seleccion-ocupado')
                : null;

            if (!celda) {
                return false;
            }

            celda.querySelectorAll('input').forEach(function (entrada) {
                entrada.checked = false;
                entrada.disabled = true;
                entrada.removeAttribute('name');
            });

            return true;
        };

        formulario.addEventListener('click', function (evento) {
            if (retirarOcupado(evento.target)) {
                evento.preventDefault();
                evento.stopPropagation();
            }
        }, true);

        formulario.addEventListener('change', function (evento) {
            if (retirarOcupado(evento.target)) {
                evento.preventDefault();
                evento.stopPropagation();
            }
        }, true);

        formulario.addEventListener('submit', function () {
            formulario.querySelectorAll('.seleccion-ocupado input').forEach(function (entrada) {
                entrada.checked = false;
                entrada.disabled = true;
                entrada.removeAttribute('name');
            });
        });
    })();
</script>
