@model SistemaEventos.Application.DTOs.CompraConfirmadaDto

@{
    ViewData["Title"] = "Compra confirmada";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-CR");

    string EtiquetaVisible(string posicion)
    {
        if (string.IsNullOrWhiteSpace(posicion))
        {
            return string.Empty;
        }

        var partes = posicion.Split('-');

        if (partes.Length == 2
            && int.TryParse(partes[0].Trim(), out var fila)
            && int.TryParse(partes[1].Trim(), out var columna)
            && fila >= 1
            && fila <= 10)
        {
            return $"{(char)('A' + fila - 1)}{columna}";
        }

        return posicion;
    }

    string Colones(int monto)
    {
        return monto.ToString("C0", cultura);
    }
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <p class="text-muted mb-1">Compra confirmada</p>
                    <h2 class="fw-bold mb-2">@Model.Nombre</h2>

                    <div class="alert alert-success" role="status">
                        La compra número @Model.CompraId quedó registrada.
                        Esta pantalla solo muestra el resultado.
                    </div>

                    <h3 class="fs-6 fw-semibold mb-3">Asientos comprados</h3>

                    @if (Model.Posiciones.Count == 0)
                    {
                        <div class="alert alert-info" role="status">
                            No hay asientos registrados en esta compra.
                        </div>
                    }
                    else
                    {
                        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-4"
                            aria-label="Asientos comprados">
                            @foreach (var posicion in Model.Posiciones)
                            {
                                <li>
                                    <span class="badge text-bg-primary fs-6">
                                        @EtiquetaVisible(posicion)
                                    </span>
                                </li>
                            }
                        </ul>
                    }

                    <dl class="row mb-4">
                        <dt class="col-sm-6">Número de compra</dt>
                        <dd class="col-sm-6">@Model.CompraId</dd>

                        <dt class="col-sm-6">Cantidad de entradas</dt>
                        <dd class="col-sm-6">@Model.Cantidad</dd>

                        <dt class="col-sm-6">Precio por entrada</dt>
                        <dd class="col-sm-6">@Colones(Model.PrecioEntrada)</dd>

                        <dt class="col-sm-6">Total</dt>
                        <dd class="col-sm-6 fw-semibold">@Colones(Model.Total)</dd>
                    </dl>

                    <a class="btn btn-outline-primary w-100 py-2"
                       asp-controller="Seleccion"
                       asp-action="Index"
                       asp-route-eventoId="@Model.EventoId">
                        Volver al mapa de asientos
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
